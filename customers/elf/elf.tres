[sub_resource type="Resource" id="Resource_st55v"]
script = ExtResource("1_4xr2c")
json_path = "res://customers/elf/orders.json"
items = Array[String](["The leaves whisper to me... but alas! my stomach is growling. Pray tell, what did Mother Nature engift you with?", "Like a breeze from the mountains, blowing since time immemorial, I have come to you from afar! Fill my innards with your good things!", "To eat is mere indulgence for one of my kind, and yet... I cannot say I don't enjoy a good meal.", "What of the forest that once stood where your inn is? It has been ages since I've last been here, nevertheless, it used to be a whole lot calmer around these parts.", "I can't pay you save with song and dance. I've wandered long and far to get here.", "Whenever I see my dear brothers and sisters of the forest being felled, I can't help but cry..."])
metadata/_custom_type_script = "uid://cp601goyny8yk"

