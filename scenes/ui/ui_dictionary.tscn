Tolph: bowl
"
fit_content = true

[node name="6" type="RichTextLabel" parent="CenterContainer/book/MarginContainer/HBoxContainer/right/VBoxContainer/right" unique_id=136770630]
visible = false
layout_mode = 2
size_flags_vertical = 6
bbcode_enabled = true
text = "That concludes this booklet. 

Dear reader, I hope you've found it useful!

Good luck on all your future endevaours.
[center]
[font_size=40]Bilbo Baggins[/font_size]
[/center]"
fit_content = true

