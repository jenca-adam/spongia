[node name="4" type="RichTextLabel" parent="CenterContainer/book/MarginContainer/HBoxContainer/left/VBoxContainer/left" unique_id=830448929]
visible = false
layout_mode = 2
size_flags_vertical = 6
bbcode_enabled = true
text = "[font_size=30]A[/font_size]

Ach : but
Ah  : and
Alu : health
Am : more
Amman : why
Aeglir : mountain range

[font_size=30]B[/font_size]

Be : like, as
Boe : must
Brant : burnt, overcooked

[font_size=30]C[/font_size]

Caeth : reason
Cauda- : to notice
Caudol : tasteful
Caw- : to taste
Cen- : to see
Cethiol : interesting
Crista- : to cut
Cuith : life
Cum: belly"
fit_content = true

[node name="5" type="RichTextLabel" parent="CenterContainer/book/MarginContainer/HBoxContainer/left/VBoxContainer/left" unique_id=1542215569]
visible = false
layout_mode = 2
size_flags_vertical = 6
bbcode_enabled = true
text = "[font_size=30]I[/font_size]
I, in : the
I : that, who, which
Iâf: fruit

[font_size=30]L[/font_size]

Lam: tongue
Lavan: animal
Le: you (plural)
Lith: ash
Lost: empty

[font_size=30]M[/font_size]

Mad-: to eat
Maetha- : to use
Math: food
Mav-: to like
Mer-: to want

[font_size=30]N[/font_size]
Nabant: almost
Naw: yes
Nin: I, me
Nín: my"
fit_content = true

