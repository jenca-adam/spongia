[node name="1" type="RichTextLabel" parent="CenterContainer/book/MarginContainer/HBoxContainer/left/VBoxContainer/left" unique_id=1469880926]
layout_mode = 2
size_flags_vertical = 6
bbcode_enabled = true
text = "[center][font_size=60]DICTIONARY[/font_size]
[font_size=30]or how to read Sindarin[/font_size]
[font_size=40]a handy-book by one[/font_size]
[font_size=60]Bilbo Baggins[/font_size]
[font_size=30]a hobbit[/font_size][/center]
"
fit_content = true

[node name="2" type="RichTextLabel" parent="CenterContainer/book/MarginContainer/HBoxContainer/left/VBoxContainer/left" unique_id=53763721]
visible = false
layout_mode = 2
size_flags_vertical = 6
bbcode_enabled = true
text = "[font_size=40]MUCH[/font_size] has been written about the Elven languages. Scholars write at great lengths about their grammatical features, and similar outlandish concepts that are of no concern to the common hobbit. However, they tend to omit such commonalities as basic vocabularyand conversational phrases that might be useful for someone travelling to Elven lands. 

This is likely because most Elves, especially ones one is likely to meet on his travels, tend to have excellent command of Common Speech as well. Therefore, there's no interest 
(or, indeed, much of a reason) in learning the language for the ordinary hobbit.

However, if one seeks to become close acquaintances with the Elves, or just add a little bit of flair to one's speech, possessing some rudimentary knowledge of Elvish can be quite helpful.

It is for this reason, as well as for a multitude of others I can't afford to bore you, dear reader, with, that I've decided to put what little I know of Elvish to writing."
fit_content = true

[node name="3" type="RichTextLabel" parent="CenterContainer/book/MarginContainer/HBoxContainer/left/VBoxContainer/left" unique_id=1293638637]
visible = false
